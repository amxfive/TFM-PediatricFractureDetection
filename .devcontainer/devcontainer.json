{
  "name": "TFM Pediatric Fracture Detection",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/frontend/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "backend": "MODEL_PATH=models_weights/generalist_architectures/E6_yoloV8m.pt nohup python3 -m uvicorn src.backend.main:app --host 0.0.0.0 --port 8000 >/tmp/tfm-backend.log 2>&1 &",
    "frontend": "BACKEND_URL=http://localhost:8000/predict nohup streamlit run src/frontend/app.py --server.port 8501 --server.address 0.0.0.0 >/tmp/tfm-frontend.log 2>&1 &"
  },
  "portsAttributes": {
    "8000": {
      "label": "Inference API"
    },
    "8501": {
      "label": "Streamlit application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    8501
  ]
}
